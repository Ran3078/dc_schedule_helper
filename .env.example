# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除，不要進版控。

# ── Discord ──────────────────────────────────────────────────────────
# Developer Portal → Bot → Reset Token
DISCORD_TOKEN=
# Developer Portal → General Information → Application ID
DISCORD_APP_ID=

# 開發用伺服器 ID（選填，留空也能正常運作）
# 本 bot 支援多伺服器，指令走 global 註冊 —— 但 Discord 對 global 指令有快取，
# 改動後最長要等 1 小時才在各伺服器生效。填了這個之後會對該伺服器額外做一次
# guild-scoped 同步（即時生效），開發時就不必等。
# 取得方式：Discord 設定 → 進階 → 開啟開發者模式 → 右鍵伺服器 → 複製伺服器 ID
DEV_GUILD_ID=

# ── Turso ────────────────────────────────────────────────────────────
# turso db show <name> --url   →  形如 libsql://xxx-yyy.turso.io
TURSO_DATABASE_URL=
# turso db tokens create <name>
TURSO_AUTH_TOKEN=

# ── 選填 ─────────────────────────────────────────────────────────────
# 保活 HTTP server 監聽的 port。Render 會自動注入 PORT，本機預設 10000
PORT=10000
# 伺服器預設時區（IANA 名稱）
DEFAULT_TZ=Asia/Taipei
LOG_LEVEL=INFO
